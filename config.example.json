{
  "noteRoot": "samples/notes",
  "randomSeed": 12345,
  "altScreen": true,
  "includeExts": [".txt", ".md"],
  "ignoreGlobs": ["Archive/*", "**/*.tmp"],
  "sortMode": "natural",
  "sortPattern": "^[0-9]+[A-Za-z0-9]*$",
  "colorMark": "#6CCB5F",
  "colorMuted": "#444444",
  "colorHi": "#FFD166",
  "colorDim": "#666666",
  "colorStatusBG": "#222222",
  "colorStatusFG": "#F5F5F5",
  "colorStatusDim": "#999999",
  "pageStep": 0,
  "navAccelMs": 350,
  "navMaxStep": 8,
  "stackVisible": 7,
  "stackOffsetX": 2,
  "stackOffsetY": 1,
  "cardWidthFrac": 0.6,
  "cardHeightFrac": 0.6,
  "activeLiftY": 2,
  "stickyOverlayNav": false,
  "maxCursorDepth": 2,
  "borderCorner": "+",
  "borderH": "-",
  "borderV": "|",
  "bindUp": ["k", "up"],
  "bindDown": ["j", "down"],
  "bindRandom": ["r"],
  "bindOverlay": ["enter"],
  "bindEdit": ["e"],
  "bindBox": ["b"],
  "bindNewFile": ["a"],
  "bindMark": ["m"],
  "bindFilter": ["t"],
  "bindHelp": ["?", "h"],
  "bindQuit": ["q"],
  "bindPageNext": ["n"],
  "bindPagePrev": ["p"],
  "bindOverlayUp": ["k", "up"],
  "bindOverlayDown": ["j", "down"]
}
